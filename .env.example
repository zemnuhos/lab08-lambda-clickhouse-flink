# ClickHouse
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=test

# Airflow
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_ADMIN_EMAIL=airflow@example.com

AIRFLOW_CONN_CLICKHOUSE_ID=clickhouse_conn

# Superset
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@example.com
SUPERSET_SECRET_KEY=admin

# Data sources
KAFKA_BOOTSTRAP_SERVERS=kafka.ijklmn.xyz:9092
KAFKA_TOPIC=lab08_transactions
KAFKA_GROUP_ID=lab08-flink-http-rt
KAFKA_STARTUP_MODE=latest-offset

# S3
S3_BUCKET=bucket_name
S3_ENDPOINT_URL=url
S3_REGION=ru-central1

# auto | public | private
S3_AUTH_MODE=auto

# нужны только для private bucket
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=